{
  "name": "otp-input",
  "version": "0.0.22",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-library": "ng build ngx-otp-code-input",
    "build-lib-watch": "ng build --watch --configuration development --project=ngx-otp-code-input",
    "test": "ng test",
    "showcase": "ng serve --project=showcase",
    "release:patch": "cd projects/ngx-otp-code-input && npm version patch --tag-version-prefix=v && cd ../.. && git push && git push --tags",
    "release:minor": "cd projects/ngx-otp-code-input && npm version minor --tag-version-prefix=v && cd ../.. && git push && git push --tags",
    "release:major": "cd projects/ngx-otp-code-input && npm version major --tag-version-prefix=v && cd ../.. && git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Swaraj55/otp-input.git"
  },
  "homepage": "https://github.com/Swaraj55/otp-input#readme",
  "bugs": {
    "url": "https://github.com/Swaraj55/otp-input/issues"
  },
  "keywords": [
    "angular",
    "otp",
    "input",
    "component",
    "javascript",
    "typescript",
    "one-time-password",
    "sms",
    "sms code",
    "ngx",
    "ngx-otp-code-input"
  ],
  "author": "Swaraj Kumar Chaturvedi",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.14",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.14",
    "@angular/compiler": "^19.2.14",
    "@angular/core": "^19.2.14",
    "@angular/forms": "^19.2.14",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.14",
    "@angular/platform-browser-dynamic": "^19.2.14",
    "@angular/router": "^19.2.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "~19.2.15",
    "@angular/compiler-cli": "^19.2.14",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.2",
    "typescript": "~5.8.3"
  }
}